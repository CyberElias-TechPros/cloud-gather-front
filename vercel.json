{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cloudgather-api.cyber-e54.workers.dev/api/:path*"
    },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/auth/:path*", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/features", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/blog/:path*", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/developers", "destination": "/index.html" },
    { "source": "/status", "destination": "/index.html" },
    { "source": "/unsubscribe", "destination": "/index.html" },
    { "source": "/verify-email", "destination": "/index.html" },
    { "source": "/l/:path*", "destination": "/index.html" },
    { "source": "/s/:path*", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/files/:path*", "destination": "/index.html" },
    { "source": "/files", "destination": "/index.html" },
    { "source": "/shared/:path*", "destination": "/index.html" },
    { "source": "/shared", "destination": "/index.html" },
    { "source": "/trash", "destination": "/index.html" },
    { "source": "/storage", "destination": "/index.html" },
    { "source": "/recents", "destination": "/index.html" },
    { "source": "/notifications", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/providers", "destination": "/index.html" },
    { "source": "/apikeys", "destination": "/index.html" },
    { "source": "/webhooks", "destination": "/index.html" },
    { "source": "/billing", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://js.stripe.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.workers.dev https://api.cloudgather.com https://api.stripe.com https://challenges.cloudflare.com; frame-src https://js.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
