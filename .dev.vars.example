# ---------------------------------------------------------------------------
# CloudGather Worker — local development secrets
#
# Copy to `.dev.vars` (git-ignored) and fill in what you need:
#
#     cp .dev.vars.example .dev.vars
#
# Everything except ALLOWED_ORIGINS is OPTIONAL. Each missing key simply turns
# its feature off — /api/config reports the capability as false and the UI hides
# or disables the corresponding flow instead of failing at runtime.
#
# In production these are Wrangler secrets, never files:
#     npx wrangler secret put <NAME>
# Non-secret values (ALLOWED_ORIGINS, APP_URL, API_URL, ENVIRONMENT, FROM_NAME,
# SUPPORT_EMAIL, SESSION_TTL_DAYS, LOG_LEVEL) belong in `[vars]` in wrangler.toml.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Exact browser origins allowed to call the API (comma separated, no wildcards).
ALLOWED_ORIGINS="http://localhost:8080,http://localhost:5173"
APP_URL="http://localhost:8080"
API_URL="http://localhost:8787/api"
ENVIRONMENT="development"
SESSION_TTL_DAYS="30"

# First account registered with this address is promoted to admin.
ADMIN_EMAIL="you@example.com"

# base64 of 32 random bytes — encrypts provider credentials and TOTP secrets.
# Generate:  openssl rand -base64 32
# Rotating this invalidates stored provider tokens and 2FA secrets.
ENCRYPTION_KEY=""

# --- Transactional email ----------------------------------------------------
# resend | postmark | sendgrid | none   (omit to auto-detect from the keys below)
# With "none" (or no key) mail is queued in the email_outbox table and visible in
# Admin → Operations, so local flows still work without a provider.
EMAIL_PROVIDER="none"
RESEND_API_KEY=""
POSTMARK_TOKEN=""
SENDGRID_API_KEY=""
FROM_EMAIL="no-reply@example.com"
FROM_NAME="CloudGather"
SUPPORT_EMAIL="support@example.com"

# --- Social sign-in ---------------------------------------------------------
# Callback URL to register with each provider: {API_URL}/auth/social/{provider}/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"

# --- Storage provider OAuth -------------------------------------------------
# Callback URL: {API_URL}/providers/{provider}/callback
# Google Drive and OneDrive fall back to the social credentials above when their
# dedicated keys are blank (add the Drive/Files scopes to that OAuth app first).
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""
ONEDRIVE_CLIENT_ID=""
ONEDRIVE_CLIENT_SECRET=""
ONEDRIVE_TENANT="common"
BOX_CLIENT_ID=""
BOX_CLIENT_SECRET=""
# Amazon S3, Backblaze B2 and other S3-compatible endpoints need no platform
# credentials — users paste their own access keys, which are encrypted with
# ENCRYPTION_KEY, so that flow requires ENCRYPTION_KEY to be set.

# --- Billing (Stripe) -------------------------------------------------------
# Without STRIPE_SECRET_KEY the pricing page still renders but checkout is hidden.
# Webhook endpoint to register: {API_URL}/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_YEARLY=""
BILLING_PORTAL_RETURN_PATH="/billing"

# --- Abuse prevention -------------------------------------------------------
# Cloudflare Turnstile. Set BOTH keys: the secret verifies tokens server-side,
# the site key is published through /api/config so the contact form can render
# the widget. Set neither and the form submits without a challenge.
TURNSTILE_SECRET_KEY=""
TURNSTILE_SITE_KEY=""

# --- Observability ----------------------------------------------------------
SENTRY_DSN=""
# debug | info | warn | error
LOG_LEVEL="info"
