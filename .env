# Leave VITE_API_URL unset in development: the app calls the relative `/api`
# path and vite.config.ts proxies it to the Worker on :8787 (override the
# target with WORKER_ORIGIN). Set it explicitly only for production builds.
# VITE_API_URL="https://api.example.com/api"
VITE_PUBLIC_SITE_URL="http://localhost:8080"
